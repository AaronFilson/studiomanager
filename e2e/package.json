{
  "name": "@studiomanager/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Smoke tests against a deployed environment. Run by deploy-dev.yml after each deploy; not part of `pnpm -r run test`.",
  "scripts": {
