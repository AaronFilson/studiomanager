# Copy to .env.local (git-ignored) and fill in. Vite reads these at build time.

# Application (client) ID of the SPA app registration in your Entra External ID tenant.
VITE_ENTRA_CLIENT_ID=

# Your External ID tenant's authority, e.g. https://<subdomain>.ciamlogin.com/
VITE_ENTRA_AUTHORITY=

# Space-separated API scopes, e.g. api://<api-app-client-id>/access_as_user
VITE_API_SCOPES=

# API origin, e.g. https://<app>.<env>.<region>.azurecontainerapps.io
# Leave empty locally: the Vite dev server proxies /api to http://localhost:8080.
VITE_API_BASE_URL=
